# Default-deny context: only cloud runtime and the independent web client.
**
!cloud/
!cloud/Dockerfile
!cloud/requirements.txt
!cloud/server.py
!backend/
!backend/npc_roles.py
!backend/relationship_manager.py
!web/
!web/package.json
!web/package-lock.json
!web/index.html
!web/tsconfig*.json
!web/vite.config.ts
!web/src/
!web/src/**
!web/public/
!web/public/characters/
!web/public/characters/*.glb

# Defense in depth within allowed source trees.
**/.env
**/.env.*
**/*.env
**/*credential*
**/*secret*
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/.git
**/.git/**
**/node_modules
**/node_modules/**
**/__pycache__
**/__pycache__/**
**/.cache
**/.cache/**
**/*.pyc
**/*.blend
**/*.blend1
**/*.log
**/logs
**/logs/**
